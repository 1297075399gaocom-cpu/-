<!doctype html>
<html lang="zh-CN">
 <head>
   <meta charset="utf-8">
   <title>全栈开发学习 - 任务列表</title>
   <style>
     /* 【核心重点注释】全局样式：设定居中、最大宽度和舒适的间距，让页面不至于太宽 */
     body { font-family: sans-serif; max-width: 500px; margin: 40px auto; padding: 20px; line-height: 1.6; }
     
     /* 【核心重点注释】弹性布局：用 Flexbox 让输入框和按钮在一行内左右排列，间距 10px */
     .input-group { display: flex; gap: 10px; margin-bottom: 20px; }
     
     /* 【核心重点注释】输入框自适应：flex: 1 表示输入框会自动撑满剩下的所有空间 */
     input[type="text"] { flex: 1; padding: 8px; font-size: 16px; }
     
     /* 【核心重点注释】按钮与列表美化：设置点击手势指针，以及列表项的底部分割线 */
     button { padding: 8px 16px; cursor: pointer; }
     ul { list-style: none; padding: 0; }
     li { padding: 8px; border-bottom: 1px solid #ccc; display: flex; justify-content: space-between; }
   </style>
 </head>
 <body>
      <h1>任务管理系统</h1>

      <!-- 【核心重点注释】用户交互区：一个文本输入框和一个触发添加任务的按钮 -->
      <div class="input-group">
         <input type="text" id="taskInput" placeholder="请输入新任务名称...">
         <button onclick="addTask()">添加任务</button>
      </div>

      <h1>任务列表 (GET 读取)</h1>
      <!-- 【核心重点注释】数据展示区：一开始显示“加载中...”，等下会用 JS 动态替换 -->
      <ul id="taskList">加载中...</ul>
       <script>
        // 【核心重点注释】当 DOM 树解析完成后，立即触发 fetchTasks 初始化获取列表数据
        document.addEventListener("DOMContentLoaded", fetchTasks);

        // 【核心重点注释】核心函数 1：通过 Async/Await 异步发起 GET 请求获取任务数据
        async function fetchTasks() {
          try {
            // 1. 向后端 /api/tasks 发起网络 GET 请求
            const response = await fetch('/api/tasks');
            
            // 2. 解析服务器返回的 JSON 数据流为 JS 数组
            const tasks = await response.json();

            // 3. 获取前端 ul 列表容器并清空“加载中...”占位符
            const list = document.getElementById('taskList');
            list.innerHTML = ''; 

            // 4. 遍历任务数组，动态创建 li 节点并渲染到 UI 界面上
            tasks.forEach(task => {
              const li = document.createElement('li');
              li.textContent = task.title;
              list.appendChild(li);
            });
          } catch (error) {
            console.error('获取列表失败:', error);
          }
        }

        // 【核心重点注释】核心函数 2：发送 POST 请求向后端添加新任务
        async function addTask() {
          const input = document.getElementById('taskInput');
          const title = input.value.trim();

          // 前端基础校验：防止用户提交空白内容
          if (!title) {
              alert('请先输入任务名称！');
              return;
          }

          try {
            // 核心：使用 fetch 发送 POST 请求
            const response = await fetch('/api/tasks', {
              method: 'POST', // 指定 HTTP 方法为 POST
              headers: {
                'Content-Type': 'application/json' // 告知后端发送的是 JSON 格式
              },
              body: JSON.stringify({ title: title }) // 将 JS 对象序列化为 JSON 字符串
            });

            if (response.ok) {
               input.value = '';   // 清空输入框
               fetchTasks();       // 重新加载列表，更新 UI 界面（已修正原代码中的拼写错误 fecthTasks）
            } else {
              const errorData = await response.json();
              alert('添加失败: ' + errorData.error);
            }
          } catch (error) {
            console.error('提交失败：', error);
          }
        }
      </script>
 </body>
</html>
